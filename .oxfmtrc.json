{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "singleAttributePerLine": true,
  "endOfLine": "lf",
  "sortImports": {
    "order": "asc",
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/assets/main.css",
    "attributes": [":class"]
  },
  "ignorePatterns": ["dist", "node_modules"]
}
